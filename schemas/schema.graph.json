{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-spector.local/graph/schema.graph.json",
  "title": "TraceabilityGraph",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "nodeType": {
      "type": "string",
      "enum": [
        "bundle",
        "sourceFile",
        "document",
        "section",
        "table",
        "diagram",
        "actor",
        "useCase",
        "feature",
        "requirement",
        "nfr",
        "dataEntity"
      ]
    },
    "edgeType": {
      "type": "string",
      "enum": [
        "partOf",
        "contains",
        "follows",
        "references",
        "listedIn",
        "definedIn",
        "describedIn",
        "satisfies",
        "dependsOn",
        "requires",
        "tracesTo",
        "derivedFrom",
        "rendersTo",
        "relatesTo",
        "translationOf"
      ]
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "$ref": "#/$defs/nodeType" },
        "template": { "type": "string" },
        "output": { "type": "string" },
        "outputPattern": { "type": "string" },
        "perDomain": {
          "type": "string",
          "description": "Domain category for this template document. Builtin values: useCase, feature, apiDetail, screenDetail. Custom packs may use any string."
        },
        "documentId": { "type": "string" },
        "heading": { "type": "string" },
        "level": { "type": "integer", "minimum": 2, "maximum": 6 },
        "order": { "type": "integer", "minimum": 0 },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "role": { "type": "string", "enum": ["source", "business", "spec"] },
        "path": { "type": "string" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/edgeType" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "role": { "type": "string" }
      }
    }
  }
}
