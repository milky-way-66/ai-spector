# ai-spector CocoIndex — environment configuration
# Copy this file to .env and fill in values as needed.
# .env is gitignored; .env.example is committed.

# Project root (default: current working directory when pipeline runs)
AI_SPECTOR_ROOT=.

# ── Storage ───────────────────────────────────────────────────────────────────

# Default: LanceDB (file-based, no server required)
# Data written to .ai-spector/.docflow/cocoindex/lance_data/
# This directory is gitignored automatically.

# Optional: Postgres + pgvector
# Requires a running Postgres instance with the pgvector extension enabled.
# COCOINDEX_DB_URL=postgresql://localhost/cocoindex

# ── Embedding model ───────────────────────────────────────────────────────────

# Default: local sentence-transformers model (~80 MB download on first run)
# COCOINDEX_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional: OpenAI embeddings (higher quality, requires API key)
# OPENAI_API_KEY=sk-...
# COCOINDEX_EMBED_MODEL=openai:text-embedding-3-small

# ── Semantic suggestions ──────────────────────────────────────────────────────

# Minimum similarity score (0–1) for graph_impact semantic suggestions.
# Suggestions below this threshold are omitted.
# COCOINDEX_SIMILARITY_THRESHOLD=0.75
