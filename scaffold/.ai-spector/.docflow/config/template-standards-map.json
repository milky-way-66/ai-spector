{
  "version": 1,
  "description": "Maps each built-in template section to ISO/IEC/IEEE (and IEEE 1016) clauses. Informative only — not a compliance certificate.",
  "standardsCatalog": {
    "ISO-29148": {
      "title": "ISO/IEC/IEEE 29148:2018",
      "role": "Requirements engineering — SRS content §9.6, requirement quality §5.2"
    },
    "ISO-12207": {
      "title": "ISO/IEC/IEEE 12207:2017",
      "role": "Software life cycle — requirements analysis §6.4.4, architectural design §6.5.3, detailed design §6.5.4"
    },
    "ISO-15288": {
      "title": "ISO/IEC/IEEE 15288:2015",
      "role": "System life cycle — stakeholder needs, requirements definition"
    },
    "ISO-15289": {
      "title": "ISO/IEC/IEEE 15289:2019",
      "role": "Life-cycle information items — SRS §10.71, design description §10.15, database design §10.14, interface §10.28, software design §10.70"
    },
    "ISO-42010": {
      "title": "ISO/IEC/IEEE 42010:2022",
      "role": "Architecture description — viewpoints, views, stakeholder concerns, decisions"
    },
    "ISO-25010": {
      "title": "ISO/IEC 25010:2011",
      "role": "Product quality model — performance, security, usability, maintainability"
    },
    "IEEE-1016": {
      "title": "IEEE Std 1016-2009",
      "role": "Software design descriptions (SDD) — design views and viewpoints; maps to 15289 design items"
    },
    "IEEE-830": {
      "title": "IEEE 830-1998 (superseded)",
      "role": "Legacy SRS outline — superseded by 29148"
    }
  },
